POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://tanken:replace-with-a-long-random-password@127.0.0.1:54329/tanken
# Optional full Unix socket filename; Compose supplies this inside Tanken only.
# DATABASE_SOCKET=/var/run/postgresql/.s.PGSQL.5432
PORT=3000
VIRTUAL_HOST=tanken.local
# Defaults to PORT in Compose. Set this to the actual internal listening port.
# VIRTUAL_PORT=3000
ANWB_CLIENT_ID=
ANWB_API_KEY=
# Identify your deployment and include a contact for public Nominatim usage.
GEOCODER_USER_AGENT=
